{
  "name": "@totoodev/installed-apps",
  "version": "1.0.0",
  "description": "Cross-platform installed application scanner (Windows / Linux / macOS) with file-association lookup and PNG icons — Node.js / Bun bindings",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">= 14"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node test.mjs",
    "build:local": "node scripts/build-local.mjs"
  },
  "napi": {
    "binaryName": "installed-apps",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ],
    "packageName": "@totoodev/installed-apps"
  },
  "optionalDependencies": {
    "@totoodev/installed-apps-win32-x64-msvc": "1.0.0",
    "@totoodev/installed-apps-win32-arm64-msvc": "1.0.0",
    "@totoodev/installed-apps-darwin-x64": "1.0.0",
    "@totoodev/installed-apps-darwin-arm64": "1.0.0",
    "@totoodev/installed-apps-linux-x64-gnu": "1.0.0",
    "@totoodev/installed-apps-linux-arm64-gnu": "1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totoodev/installed-apps.git"
  }
}
