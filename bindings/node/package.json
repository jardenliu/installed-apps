{
  "name": "installed-apps-scanner",
  "version": "0.2.1",
  "description": "Cross-platform installed application scanner (Windows / Linux / macOS) with file-association lookup and PNG icons — Node.js / Bun bindings",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">= 14"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node test.mjs",
    "build:local": "node scripts/build-local.mjs"
  },
  "napi": {
    "binaryName": "installed-apps",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ],
    "packageName": "installed-apps-scanner"
  },
  "optionalDependencies": {
    "installed-apps-scanner-win32-x64-msvc": "0.2.1",
    "installed-apps-scanner-win32-arm64-msvc": "0.2.1",
    "installed-apps-scanner-darwin-x64": "0.2.1",
    "installed-apps-scanner-darwin-arm64": "0.2.1",
    "installed-apps-scanner-linux-x64-gnu": "0.2.1",
    "installed-apps-scanner-linux-arm64-gnu": "0.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jardenliu/installed-apps.git"
  }
}
